# Copy to .env.local. Never commit secrets. Rebuild after changing public values.
SITE_URL=http://localhost:3000
# Enable after setting a real HTTPS domain on a host that supplies X-Forwarded-Proto.
CANONICAL_REDIRECTS=false
GOOGLE_SITE_VERIFICATION=
NEXT_TELEMETRY_DISABLED=1

# Stripe: start with test-mode keys. All prices come from approved content.
STRIPE_SECRET_KEY=
# Required for physical books: preconfigured Stripe shipping rate IDs.
STRIPE_SHIPPING_RATE_IDS=
STRIPE_SHIPPING_COUNTRIES=US
# Only enable after configuring Stripe Tax and your tax registrations.
STRIPE_AUTOMATIC_TAX=false

# Resend: verify the sending domain first. Recipient is content/site.json email.
RESEND_API_KEY=
CONTACT_FROM=

# Brevo: double-opt-in template and audience list; provider handles unsubscribe.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=

# Required for production form protection. Register the exact production hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Durable rate limiter (Upstash REST). Trusted host must overwrite proxy headers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to vercel or cloudflare only when hosted behind that trusted proxy.
TRUSTED_PROXY=

# Decap CMS: GitHub accounts must have repository write access.
ADMIN_GITHUB_REPO=
ADMIN_GITHUB_BRANCH=main
# Your Decap-compatible OAuth server URL; no tokens or secrets here.
ADMIN_OAUTH_URL=
ADMIN_OAUTH_ENDPOINT=auth
